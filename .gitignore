# KiCad: https://www.kicad.org/
# https://go.kicad.org/p/help/file-formats

# Caches
fp-info-cache
sym-lib-cache
*-cache.lib

# Lock files (KiCad open / autosave)
*.lck
~*

# Per-user UI state (window layout, etc.)
*.kicad_prl
*.kicad_prl-bak

# Local history extension
.history/

# Automatic backups
*-backups/
**/.versions/
_autosave-*
_restore_backup_*/

# Editor / KiCad backup files
*.000
*.bak
*.bck
*.backup
*.kicad_pcb-bak
*.kicad_sch-bak
*.kicad_pro-bak
*.sch-bak
*.tmp
*-save.pro
*-save.kicad_pcb

# Scratch
untitled.kicad_sch

# Autorouter exports
*.dsn
*.ses

# Regenerable outputs (Fabrication Toolkit, etc.)
gerbers/
Gerbers/
fabrication/
production/
*.gbrjob

# Optional tool exports (re-run ERC/DRC in CI or locally)
*-erc.json
*-drc.json

# OS & IDE
Thumbs.db
Desktop.ini
.DS_Store
.idea/
.vscode/